#!/usr/bin/env python3
import json
import os
import sys


def main(argv: list[str]) -> int:
    if not argv or argv[0] != "api":
        sys.stderr.write(f"fake gh: only `gh api` is faked, not {argv!r}\n")
        return 2
    method = "GET"
    path = None
    stdin = None
    rest = argv[1:]
    while rest:
        arg = rest.pop(0)
        if arg == "-X":
            method = rest.pop(0)
        elif arg == "--input":
            source = rest.pop(0)
            stdin = sys.stdin.read() if source == "-" else open(source, encoding="utf-8").read()
        elif arg == "--paginate":
            continue
        elif arg.startswith("-"):
            sys.stderr.write(f"fake gh: unexpected flag {arg}\n")
            return 2
        else:
            path = arg
    key = f"{method} {path}"
    with open(os.environ["FAKE_GH_LOG"], "a", encoding="utf-8") as log:
        log.write(json.dumps({"call": key, "input": stdin}) + "\n")
    with open(os.environ["FAKE_GH_ANSWERS"], encoding="utf-8") as file:
        answers = json.load(file)
    if key not in answers:
        sys.stderr.write(f"gh: Not Found (HTTP 404) for {key}\n")
        return 1
    answer = answers[key]
    if isinstance(answer, dict) and "__status__" in answer:
        sys.stderr.write(f"gh: HTTP {answer['__status__']} for {key}\n")
        return 1
    json.dump(answer, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
