#!/usr/bin/env python3
import os
import shutil
import sys


def main(argv: list[str]) -> int:
    with open(os.environ["FAKE_CURL_LOG"], "a", encoding="utf-8") as log:
        log.write(" ".join(argv) + "\n")
    if os.environ.get("FAKE_CURL_EXIT"):
        sys.stderr.write("curl: (6) Could not resolve host\n")
        return int(os.environ["FAKE_CURL_EXIT"])
    output = argv[argv.index("--output") + 1]
    url = argv[-1]
    served = os.path.join(os.environ["FAKE_CURL_SERVE"], url.rsplit("/", 1)[-1])
    if not os.path.exists(served):
        sys.stderr.write("curl: (22) The requested URL returned error: 404\n")
        return 22
    shutil.copyfile(served, output)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
