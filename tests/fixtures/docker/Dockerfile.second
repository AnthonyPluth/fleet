# The Self-test's second image for docker.yml: its entrypoint fails, so its check passes only when second-smoke-command
# replaces it with `sh /smoke.sh`, and smoke.sh passes only in a container run as the check runs it.
FROM mirror.gcr.io/library/busybox:1.37.0
ARG VERSION=""
COPY second-smoke.sh /smoke.sh
USER 65534:65534
HEALTHCHECK NONE
ENTRYPOINT ["false"]
